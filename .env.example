# DataWarden local configuration. Copy with `make setup` (generates secrets into .env).
# Never commit .env. Secret fields left empty here are generated locally.

DW_ENV=local
DW_DEMO_MODE=true
DW_SEED=42
DW_DEMO_START_DATE=2026-08-01
DW_DEMO_DAYS=30
DW_BUSINESS_TZ=Asia/Kolkata
DW_MART_LOOKBACK_DAYS=2

# --- PostgreSQL: application database -------------------------------------------------
DW_APP_DB_HOST=localhost
DW_APP_DB_PORT=5432
DW_APP_DB_NAME=datawarden_app
DW_APP_DB_USER=dw_app
DW_APP_DB_PASSWORD=

# --- PostgreSQL: warehouse --------------------------------------------------------------
DW_WH_HOST=localhost
DW_WH_PORT=5432
DW_WH_DB_NAME=datawarden_wh
# Bootstrap superuser (setup commands only). For a host PostgreSQL, set this to your
# superuser's real password. For Docker Compose it is generated and used by the containers.
DW_PG_ADMIN_USER=postgres
DW_PG_ADMIN_PASSWORD=
DW_WH_PIPELINE_PASSWORD=
DW_WH_AGENT_RO_PASSWORD=
DW_WH_SHADOW_PASSWORD=
DW_WH_EXECUTOR_PASSWORD=
DW_WH_VALIDATOR_PASSWORD=

# --- Service secrets ----------------------------------------------------------------------
DW_INGEST_HMAC_SECRET=
DW_SESSION_SECRET=
DW_API_BASE_URL=http://localhost:8000
DW_CORS_ORIGINS=http://localhost:5173

# --- Models: fixture (offline, deterministic) | openai_compatible | azure_openai ------------
DW_MODEL_PROVIDER=fixture
DW_MODEL_NAME=
DW_MODEL_ENDPOINT=
DW_MODEL_API_KEY=
DW_MODEL_API_VERSION=
DW_MODEL_TIMEOUT_S=60
DW_MODEL_TOKEN_BUDGET=200000
# Optional pricing (per 1k tokens). Leave empty to show cost as "unavailable".
DW_MODEL_PRICE_INPUT_PER_1K=
DW_MODEL_PRICE_OUTPUT_PER_1K=

# --- Optional integrations (disabled when empty) ------------------------------------------
DW_GITHUB_TOKEN=
DW_GITHUB_REPO=
DW_AIRFLOW_BASE_URL=
DW_AIRFLOW_USERNAME=
DW_AIRFLOW_PASSWORD=
DW_WEBHOOK_URL=
DW_LANGFUSE_HOST=
DW_OTEL_EXPORTER_OTLP_ENDPOINT=
